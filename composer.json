{
    "name": "rgusseinov/arc-php-framework",
    "description": "Mini php framework",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Arc\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ruslan",
            "email": "r.gusseinov@mail.ru"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix"
    },
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    }
}
